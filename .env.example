# 运行
HOST=127.0.0.1
PORT=3000
# 反向代理后使用部署域名，例如 https://beads.example.com
PUBLIC_ORIGIN=
# 默认 data/studio.sqlite。生产可指向持久卷上的文件。
DB_FILE=

# 设置两个值后，通过 /me?setup=1 注册一次管理员账号。
ADMIN_ACCOUNT=
ADMIN_BOOTSTRAP_SECRET=

# 设为 1 后，用户需要有效卡密才可生成、编辑和发布图纸。
REQUIRE_MEMBERSHIP=1
CARD_SHOP_URL=
COMMUNITY_URL=
SUPPORT_EMAIL=

# 可选：公开的 S3 图纸目录 JSON。服务端只读取目录元数据，预览图从对象公开 URL 加载。
REMOTE_LIBRARY_MANIFEST_URL=https://pindou.cn-nb1.rains3.com/pixel-cafe/data/patterns.json


